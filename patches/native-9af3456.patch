+//go:build desktop
+
+package docparser
+
+import "runtime"
+
+// preferredNativeEngine routes the desktop app's default parser to the local
+// engine. It is intentionally gated by the "desktop" build tag: the Lite CLI
+// and full server keep their existing docreader/default behavior.
+func preferredNativeEngine(fileType string) string {
+	switch normalizeNativeType(fileType) {
+	case "pdf":
+		if nativePDFHelperPath() != "" {
+			return NativeEngineName
+		}
+	case "doc":
+		if runtime.GOOS == "darwin" {
+			return NativeEngineName
+		}
+	case "docx", "xlsx", "pptx", "html", "htm", "url":
+		return NativeEngineName
+	}
+	return ""
+}
diff --git a/internal/infrastructure/docparser/native_reader.go b/internal/infrastructure/docparser/native_reader.go
new file mode 100644
--- /dev/null
+++ b/internal/infrastructure/docparser/native_reader.go
@@ -0,0 +1,65 @@
+package docparser
+
+import (
+	"context"
+	"fmt"
+	"path/filepath"
+	"strings"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// NativeReader handles PDF, Office and HTML files in-process on macOS/Lite.
+// Office and HTML conversion is pure Go; PDF delegates to the bundled pdf2md
+// helper (PDFKit + Vision OCR), so a desktop install needs no Python service.
+type NativeReader struct{}
+
+func (r *NativeReader) Read(ctx context.Context, req *types.ReadRequest) (*types.ReadResult, error) {
+	if req == nil {
+		return nil, fmt.Errorf("native parser: empty request")
+	}
+	if strings.TrimSpace(req.URL) != "" {
+		md, err := nativeURLToMarkdown(ctx, req.URL)
+		if err != nil {
+			return nil, err
+		}
+		return &types.ReadResult{MarkdownContent: md}, nil
+	}
+
+	ft := normalizeNativeType(req.FileType)
+	if ft == "" {
+		ft = strings.TrimPrefix(strings.ToLower(filepath.Ext(req.FileName)), ".")
+	}
+
+	var (
+		md  string
+		err error
+	)
+	switch ft {
+	case "pdf":
+		md, err = nativePDFToMarkdown(ctx, req)
+	case "doc":
+		md, err = nativeDOCToMarkdown(ctx, req.FileContent)
+	case "docx":
+		md, err = nativeDOCXToMarkdown(req.FileContent)
+	case "xlsx":
+		md, err = nativeXLSXToMarkdown(req.FileContent)
+	case "pptx":
+		md, err = nativePPTXToMarkdown(req.FileContent)
+	case "html", "htm":
+		md, err = nativeHTMLToMarkdown(req.FileContent)
+	default:
+		return nil, fmt.Errorf("native parser: unsupported file type %q", ft)
+	}
+	if err != nil {
+		return nil, err
+	}
+	if strings.TrimSpace(md) == "" {
+		return nil, fmt.Errorf("native parser: no text extracted from %s", ft)
+	}
+	return &types.ReadResult{MarkdownContent: md}, nil
+}
+
+func normalizeNativeType(fileType string) string {
+	return strings.TrimPrefix(strings.ToLower(strings.TrimSpace(fileType)), ".")
+}
diff --git a/tools/pdf2md/pdf2md.swift b/tools/pdf2md/pdf2md.swift
new file mode 100644
--- /dev/null
+++ b/tools/pdf2md/pdf2md.swift
@@ -0,0 +1,98 @@
+import Foundation
+import PDFKit
+import Vision
+import AppKit
+
+// pdf2md: 用 macOS 原生 PDFKit 抽取数字文本；无文字层的页面用 Vision OCR。
+// 输出 Markdown（按页分节）到 stdout；诊断信息写 stderr。
+
+func stderr(_ message: String) {
+    if let data = (message + "\n").data(using: .utf8) {
+        FileHandle.standardError.write(data)
+    }
+}
+
+func ocrText(from image: CGImage) throws -> String {
+    let request = VNRecognizeTextRequest()
+    request.recognitionLevel = .accurate
+    request.usesLanguageCorrection = true
+    request.recognitionLanguages = ["zh-Hans", "en-US"]
+
+    let handler = VNImageRequestHandler(cgImage: image, options: [:])
+    try handler.perform([request])
+
+    guard let observations = request.results else { return "" }
+    let lines: [(CGFloat, CGFloat, String)] = observations.compactMap { obs in
+        guard let candidate = obs.topCandidates(1).first else { return nil }
+        let box = obs.boundingBox
+        // Vision 的坐标原点在左下；-midY 让页面从上到下排序。
+        return (-box.midY, box.minX, candidate.string)
+    }.sorted { lhs, rhs in
+        if abs(lhs.0 - rhs.0) > 0.012 { return lhs.0 < rhs.0 }
+        return lhs.1 < rhs.1
+    }
+    return lines.map { $0.2 }.joined(separator: "\n")
+}
+
+func render(page: PDFPage, scale: CGFloat) -> CGImage? {
+    let bounds = page.bounds(for: .mediaBox)
+    let width = Int((bounds.width * scale).rounded())
+    let height = Int((bounds.height * scale).rounded())
+    guard width > 0, height > 0 else { return nil }
+    guard let context = CGContext(
+        data: nil,
+        width: width,
+        height: height,
+        bitsPerComponent: 8,
+        bytesPerRow: 0,
+        space: CGColorSpaceCreateDeviceRGB(),
+        bitmapInfo: CGImageAlphaInfo.premultipliedLast.rawValue
+    ) else { return nil }
+
+    context.setFillColor(NSColor.white.cgColor)
+    context.fill(CGRect(x: 0, y: 0, width: width, height: height))
+    context.scaleBy(x: scale, y: scale)
+    page.draw(with: .mediaBox, to: context)
+    return context.makeImage()
+}
+
+func main() -> Int32 {
+    let args = CommandLine.arguments
+    guard args.count >= 2 else {
+        stderr("用法: pdf2md <input.pdf>")
+        return 1
+    }
+    let url = URL(fileURLWithPath: args[1])
+    guard let document = PDFDocument(url: url) else {
+        stderr("无法打开 PDF: \(url.path)")
+        return 2
+    }
+    guard document.pageCount > 0 else {
+        stderr("PDF 没有页面: \(url.path)")
+        return 2
+    }
+
+    print("# \(url.lastPathComponent)\n")
+    var ocrPages = 0
+    for index in 0..<document.pageCount {
+        autoreleasepool {
+            guard let page = document.page(at: index) else { return }
+            let native = (page.string ?? "").trimmingCharacters(in: .whitespacesAndNewlines)
+            var text = native
+            if native.count < 10 {
+                if let image = render(page: page, scale: 2.0),
+                   let recognized = try? ocrText(from: image) {
+                    text = recognized.trimmingCharacters(in: .whitespacesAndNewlines)
+                    if !text.isEmpty { ocrPages += 1 }
+                }
+            }
+            print("## 第 \(index + 1) 页\n")
+            print(text.isEmpty ? "（本页无可提取文字）" : text)
+            print("\n")
+        }
+    }
+    stderr("页数: \(document.pageCount)，OCR 页数: \(ocrPages)")
+    return 0
+}
+
+exit(main())
