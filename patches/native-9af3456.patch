+package docparser
+
+import (
+	"archive/zip"
+	"bytes"
+	"context"
+	"testing"
+
+	"github.com/Tencent/WeKnora/internal/types"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+)
+
+func nativeTestZip(t *testing.T, files map[string]string) []byte {
+	t.Helper()
+	var buf bytes.Buffer
+	zw := zip.NewWriter(&buf)
+	for name, body := range files {
+		w, err := zw.Create(name)
+		require.NoError(t, err)
+		_, err = w.Write([]byte(body))
+		require.NoError(t, err)
+	}
+	require.NoError(t, zw.Close())
+	return buf.Bytes()
+}
+
+func TestNativeDOCXExtractsParagraphsAndTable(t *testing.T) {
+	data := nativeTestZip(t, map[string]string{
+		"word/document.xml": `<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
+<w:body>
+<w:p><w:r><w:t>Hello WeKnora</w:t></w:r></w:p>
+<w:tbl>
+<w:tr><w:tc><w:p><w:r><w:t>A</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>B</w:t></w:r></w:p></w:tc></w:tr>
+<w:tr><w:tc><w:p><w:r><w:t>1</w:t></w:r></w:p></w:tc><w:tc><w:p><w:r><w:t>2</w:t></w:r></w:p></w:tc></w:tr>
+</w:tbl>
+</w:body></w:document>`,
+	})
+	md, err := nativeDOCXToMarkdown(data)
+	require.NoError(t, err)
+	assert.Contains(t, md, "Hello WeKnora")
+	assert.Contains(t, md, "| A | B |")
+	assert.Contains(t, md, "| 1 | 2 |")
+}
+
+func TestNativeXLSXExtractsSharedStrings(t *testing.T) {
+	data := nativeTestZip(t, map[string]string{
+		"xl/sharedStrings.xml": `<sst xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><si><t>Name</t></si><si><t>Value</t></si><si><t>Alpha</t></si><si><t>42</t></si></sst>`,
+		"xl/worksheets/sheet1.xml": `<worksheet xmlns="http://schemas.openxmlformats.org/spreadsheetml/2006/main"><sheetData>
+<row r="1"><c r="A1" t="s"><v>0</v></c><c r="B1" t="s"><v>1</v></c></row>
+<row r="2"><c r="A2" t="s"><v>2</v></c><c r="B2" t="s"><v>3</v></c></row>
+</sheetData></worksheet>`,
+	})
+	md, err := nativeXLSXToMarkdown(data)
+	require.NoError(t, err)
+	assert.Contains(t, md, "| Name | Value |")
+	assert.Contains(t, md, "| Alpha | 42 |")
+}
+
+func TestNativePPTXExtractsSlideText(t *testing.T) {
+	data := nativeTestZip(t, map[string]string{
+		"ppt/slides/slide1.xml": `<p:sld xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><p:cSld><p:spTree><p:sp><p:txBody><a:p><a:r><a:t>Slide title</a:t></a:r></a:p></p:txBody></p:sp></p:spTree></p:cSld></p:sld>`,
+	})
+	md, err := nativePPTXToMarkdown(data)
+	require.NoError(t, err)
+	assert.Contains(t, md, "## Slide 1")
+	assert.Contains(t, md, "Slide title")
+}
+
+func TestNativeHTMLConvertsToMarkdown(t *testing.T) {
+	md, err := nativeHTMLToMarkdown([]byte(`<h1>Title</h1><p>Hello <strong>world</strong></p>`))
+	require.NoError(t, err)
+	assert.Contains(t, md, "# Title")
+	assert.Contains(t, md, "Hello **world**")
+}
+
+func TestNativeReaderDispatchesHTML(t *testing.T) {
+	reader := &NativeReader{}
+	result, err := reader.Read(context.Background(), &types.ReadRequest{
+		FileName: "page.html",
+		FileType: "html",
+		FileContent: []byte(`<h1>Local</h1><p>body</p>`),
+	})
+	require.NoError(t, err)
+	assert.Contains(t, result.MarkdownContent, "# Local")
+}
diff --git a/internal/infrastructure/docparser/native_pdf_darwin.go b/internal/infrastructure/docparser/native_pdf_darwin.go
new file mode 100644
--- /dev/null
+++ b/internal/infrastructure/docparser/native_pdf_darwin.go
@@ -0,0 +1,81 @@
+//go:build darwin
+
+package docparser
+
+import (
+	"bytes"
+	"context"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+
+	"github.com/Tencent/WeKnora/internal/types"
+)
+
+// nativePDFHelperPath locates the bundled pdf2md executable. Packaged apps
+// keep it in Contents/Resources; dev runs can set WEKNORA_PDF2MD.
+func nativePDFHelperPath() string {
+	if p := strings.TrimSpace(os.Getenv("WEKNORA_PDF2MD")); p != "" {
+		if nativeExecutableFile(p) {
+			return p
+		}
+	}
+	exe, err := os.Executable()
+	if err == nil {
+		const marker = ".app/Contents/MacOS"
+		if i := strings.Index(exe, marker); i >= 0 {
+			p := filepath.Join(exe[:i+len(".app/Contents")], "Resources", "pdf2md")
+			if nativeExecutableFile(p) {
+				return p
+			}
+		}
+	}
+	if p, err := exec.LookPath("pdf2md"); err == nil {
+		return p
+	}
+	return ""
+}
+
+func nativeExecutableFile(path string) bool {
+	info, err := os.Stat(path)
+	return err == nil && !info.IsDir() && info.Mode()&0111 != 0
+}
+
+func nativePDFToMarkdown(ctx context.Context, req *types.ReadRequest) (string, error) {
+	helper := nativePDFHelperPath()
+	if helper == "" {
+		return "", fmt.Errorf("native PDF helper not found; rebuild the desktop app or set WEKNORA_PDF2MD")
+	}
+	if len(req.FileContent) == 0 {
+		return "", fmt.Errorf("native PDF parser: empty file")
+	}
+
+	f, err := os.CreateTemp("", "weknora-native-*.pdf")
+	if err != nil {
+		return "", fmt.Errorf("native PDF parser: create temp file: %w", err)
+	}
+	name := f.Name()
+	defer os.Remove(name)
+	if _, err := f.Write(req.FileContent); err != nil {
+		f.Close()
+		return "", fmt.Errorf("native PDF parser: write temp file: %w", err)
+	}
+	if err := f.Close(); err != nil {
+		return "", fmt.Errorf("native PDF parser: close temp file: %w", err)
+	}
+
+	cmd := exec.CommandContext(ctx, helper, name)
+	var stdout, stderr bytes.Buffer
+	cmd.Stdout = &stdout
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		msg := strings.TrimSpace(stderr.String())
+		if msg == "" {
+			msg = err.Error()
+		}
+		return "", fmt.Errorf("native PDF parser: %s", msg)
+	}
+	return stdout.String(), nil
+}
